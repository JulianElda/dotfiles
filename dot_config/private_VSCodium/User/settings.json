{
  "[go]": {
    "editor.defaultFormatter": "golang.go",
  },
  "better-comments.tags": [
    {
      "backgroundColor": "transparent",
      "bold": false,
      "color": "#FF2D00",
      "italic": false,
      "strikethrough": false,
      "tag": "!",
      "underline": false,
    },
    {
      "backgroundColor": "transparent",
      "bold": false,
      "color": "#3498DB",
      "italic": false,
      "strikethrough": false,
      "tag": "?",
      "underline": false,
    },
    {
      "backgroundColor": "transparent",
      "bold": false,
      "color": "#474747",
      "italic": false,
      "strikethrough": true,
      "tag": "//",
      "underline": false,
    },
    {
      "backgroundColor": "transparent",
      "bold": false,
      "color": "#FF8C00",
      "italic": false,
      "strikethrough": false,
      "tag": "todo",
      "underline": false,
    },
    {
      "backgroundColor": "transparent",
      "bold": false,
      "color": "#98C379",
      "italic": false,
      "strikethrough": false,
      "tag": "*",
      "underline": false,
    },
  ],
  "breadcrumbs.enabled": false,
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com": {
      "approveRequest": false,
      "approveResponse": true,
    },
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://raw.githubusercontent.com": {
      "approveRequest": false,
      "approveResponse": true,
    },
  },
  "css.completion.triggerPropertyValueCompletion": false,
  "debug.console.fontSize": 18,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.cursorBlinking": "smooth",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.dragAndDrop": false,
  "editor.fontFamily": "Iosevka SS13",
  "editor.fontLigatures": true,
  "editor.fontSize": 16,
  "editor.formatOnSave": true,
  "editor.glyphMargin": false,
  "editor.guides.indentation": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.inlineSuggest.fontFamily": "Iosevka SS13",
  "editor.lineHeight": 24,
  "editor.minimap.enabled": false,
  "editor.quickSuggestionsDelay": 100,
  "editor.renderLineHighlight": "none",
  "editor.stickyScroll.enabled": false,
  "editor.stickyScroll.scrollWithEditor": false,
  "editor.tabSize": 2,
  "emmet.showAbbreviationSuggestions": false,
  "emmet.showExpandedAbbreviation": "never",
  "explorer.autoReveal": false,
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.decorations.badges": false,
  "explorer.decorations.colors": false,
  "extensions.ignoreRecommendations": true,
  "git.blame.editorDecoration.enabled": false,
  "git.confirmSync": false,
  "git.decorations.enabled": false,
  "git.openRepositoryInParentFolders": "never",
  "github.copilot.nextEditSuggestions.enabled": true,
  "http.proxyStrictSSL": false,
  "http.proxySupport": "on",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "oxc.requireConfig": true,
  "remote.autoForwardPorts": false,
  "scm.diffDecorations": "gutter",
  "security.workspace.trust.untrustedFiles": "open",
  "svelte.enable-ts-plugin": true,
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.defaultLocation": "editor",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.drawBoldTextInBrightColors": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.fontFamily": "Iosevka SS13",
  "terminal.integrated.lineHeight": 1.1,
  "terminal.integrated.profiles.linux": {
    "bash": {
      "icon": "terminal-bash",
      "path": "bash",
    },
    "zsh": {
      "path": "/usr/bin/zsh",
    },
  },
  "terminal.integrated.stickyScroll.enabled": false,
  "window.commandCenter": false,
  "window.menuBarVisibility": "toggle",
  "window.title": "${dirty}${rootNameShort}",
  "window.zoomLevel": 2,
  "window.zoomPerWindow": false,
  "workbench.activityBar.location": "top",
  "workbench.colorCustomizations": {
    "editorBracketHighlight.foreground1": "#ffffff",
    "editorBracketHighlight.foreground2": "#e3bbbb",
    "editorBracketHighlight.foreground3": "#bccad6",
    "editorBracketHighlight.foreground4": "#f0e1bc",
    "editorBracketHighlight.foreground5": "#aae3d9",
    "editorBracketHighlight.foreground6": "#c4b7d4",
    "editorBracketHighlight.unexpectedBracket.foreground": "#db6165",
    "editorError.foreground": "#ff666666",
    "editorGutter.addedBackground": "#4b6f4455",
    "editorGutter.deletedBackground": "#ff666655",
    "editorGutter.modifiedBackground": "#658aa255",
    "editorLineNumber.activeForeground": "#3f3f3f",
    "editorLineNumber.foreground": "#3f3f3f",
    "editorWarning.foreground": "#ffff0066",
    "gitDecoration.modifiedResourceForeground": "#658aa2",
    "gitDecoration.untrackedResourceForeground": "#a2cbb1",
    "list.errorForeground": "#a18888",
    "list.warningForeground": "#afa58c",
    "statusBarItem.remoteBackground": "#22223D",
    "statusBarItem.remoteForeground": "#999",
    "terminal.ansiBlue": "#73D0FF",
    "terminal.ansiGreen": "#D5FF80",
    "terminal.ansiYellow": "#FFD173",
    "terminal.background": "#242936",
  },
  "workbench.colorTheme": "Ayu Mirage Bordered",
  "workbench.editor.decorations.badges": false,
  "workbench.editor.editorActionsLocation": "titleBar",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.splitInGroupLayout": "vertical",
  "workbench.editor.tabActionCloseVisibility": false,
  "workbench.editorAssociations": {
    "*.svg": "default",
  },
  "workbench.enableExperiments": false,
  "workbench.iconTheme": "ayu",
  "workbench.layoutControl.enabled": false,
  "workbench.preferredDarkColorTheme": "Ayu Mirage",
  "workbench.settings.enableNaturalLanguageSearch": false,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.tree.enableStickyScroll": false,
  "go.toolsManagement.autoUpdate": true,
  "claudeCode.preferredLocation": "panel",
  "chat.titleBar.signIn.enabled": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "workbench.browser.showInTitleBar": false,
  "chat.editor.fontSize": 16,
  "chat.editor.fontFamily": "IBM Plex Mono",
  "chat.fontFamily": "IBM Plex Sans",
  "chat.fontSize": 16,
  "chat.inlineReferences.style": "link",
  "chat.editor.claude.preferAgentHost": true,
  "chat.viewSessions.enabled": false,
  "oxc.enable.oxfmt": true,
  "oxc.enable.oxlint": true,
  "oxc.enable": true,
  "claudeCode.useCtrlEnterToSend": true,
}
