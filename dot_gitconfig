[user]
	email = julius.polar@gmail.com
	name = Julius Polar
	signingkey = ~/.ssh/id_ed25519.pub

[commit]
  gpgsign = true

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

[core]
	editor = vim

[fetch]
	prune = true

[core]
	editor = vim
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  side-by-side = true