[user]
	email = julius.polar@gmail.com
	name = Julius Polar
	signingkey = ~/.ssh/id_ed25519.pub

[commit]
  gpgsign = true

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

[core]
	editor = vim
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  dark = true
	side-by-side = true
  # --mouse makes the wheel scroll the pager, not the terminal's scrollback
  pager = less -FR --mouse --wheel-lines=3

# difftastic is opt-in (`git difft`, `git difftool`), not diff.external: its
# output is not a valid patch and would break `git apply` and `git add -p`.
[diff]
  tool = difftastic

[difftool]
  prompt = false

[difftool "difftastic"]
  cmd = difft \"$LOCAL\" \"$REMOTE\"

[pager]
  difftool = true

[alias]
  difft = -c diff.external=difft -c core.pager='less -FR --mouse' diff

[merge]
  conflictStyle = zdiff3

[init]
	defaultBranch = master

[push]
  autoSetupRemote = true
